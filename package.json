{
  "name": "dsh-plugin-jws-image",
  "version": "0.1.0",
  "description": "JWS image generation for DeepSeek Harness: a jws_generate_image tool plus a composer-dock generation window, over the native image.aijws.com API.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/probe.js", "lib/credentials.js", "lib/jws-api.js", "lib/contract.js", "contract/snapshot.json", "cordis.patch.yml", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": { "test": "node --test" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-conversation"] }
  },
  "peerDependencies": { "@deepseek-ai/cordis": "*", "@deepseek-ai/dsh-tools": "*" },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  }
}